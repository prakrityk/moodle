{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper }}
{{!-- DEBUG: Custom prakrity loginform template loaded --}}
<div style="background: green; color: white; padding: 10px; text-align: center;">
  PRAKRITY THEME LOGIN IS WORKING!
</div>

<div style="display: flex; min-height: 100vh;">
    <!-- LEFT SIDE - Branding -->
    <div style="flex: 1; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white;">
        <div style="text-align: center; padding: 40px;">
            <h1 style="font-size: 2.5rem; margin-bottom: 10px;">Welcome to</h1>
            <h2 style="font-size: 2rem; margin-bottom: 20px;">Southern Academy<br><span style="font-weight: normal;">of Higher Education</span></h2>
            <p style="font-size: 1.2rem; opacity: 0.9;">Your learning journey starts here</p>
        </div>
    </div>

    <!-- RIGHT SIDE - Login Form -->
    <div style="flex: 1; display: flex; align-items: center; justify-content: center; background: #f8f9fa;">
        <div style="width: 100%; max-width: 400px; padding: 40px;">
            <div style="text-align: center; margin-bottom: 30px;">
                {{! {{#logourl}}<img src="{{{logourl}}}" alt="Site Logo" style="max-height: 60px; margin-bottom: 20px;">{{/logourl}} }}
                <h2 style="color: #333; margin-bottom: 10px;">Sign in to SAHE</h2>
                <p style="color: #666;">Enter your details to continue</p>
            </div>

            {{> core/loginform }}
        </div>
    </div>
</div>

{{> theme_boost/footer }}

</body>
</html>