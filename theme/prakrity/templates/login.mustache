<div style="background: red; color: white; padding: 10px; text-align: center;">
  CUSTOM TEMPLATE IS WORKING!
</div>
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper }}

<div class="login-wrapper">
  <!-- LEFT SIDE WITH KANGAROO IMAGE -->
  <div class="login-left">
    <!-- Background image handled by CSS -->
  </div>

  <!-- RIGHT SIDE WITH LOGO + FORM -->
  <div class="login-right">
    <div class="login-logo">
      {{#logourl}}<img src="{{{logourl}}}" alt="{{sitename}}" class="img-fluid">{{/logourl}}
      <span>Southern Academy of Higher Education</span>
    </div>
    <h2>Sign in to SAHE</h2>
    <p>Enter your details to continue</p>

    <div class="login-form-container">
      {{#error}}
        <div class="alert alert-danger" role="alert" data-aria-autofocus="true">{{error}}</div>
      {{/error}}
      
      <form class="mt-3" action="{{{loginurl}}}" method="post" id="login">
        <input id="anchor" type="hidden" name="anchor" value="">
        <script>document.getElementById('anchor').value = location.hash;</script>
        
        <div class="form-group">
          <label for="username" class="sr-only">{{#str}} username {{/str}}</label>
          <input type="text" name="username" id="username" 
                 class="form-control" 
                 value="{{{username}}}"
                 placeholder="{{#str}}username{{/str}}"
                 autocomplete="username">
        </div>
        
        <div class="form-group">
          <label for="password" class="sr-only">{{#str}} password {{/str}}</label>
          <input type="password" name="password" id="password" 
                 class="form-control" 
                 placeholder="{{#str}}password{{/str}}"
                 autocomplete="current-password">
        </div>
        
        <div class="rememberpass mt-3">
          <input type="checkbox" name="rememberusername" id="rememberusername" value="1" {{#username}}checked="checked"{{/username}}>
          <label for="rememberusername">{{#str}} rememberusername, admin {{/str}}</label>
        </div>
        
        <button class="btn btn-primary btn-block mt-3" type="submit" id="loginbtn">{{#str}}login{{/str}}</button>
      </form>
    </div>

    <div class="student-links mt-3">
      <a href="{{forgotpasswordurl}}">{{#str}}forgotten{{/str}}</a>
      {{#cansignup}}
        <a href="{{signupurl}}">{{#str}}startsignup{{/str}}</a>
      {{/cansignup}}
    </div>
  </div>
</div>

{{> theme_boost/footer }}

{{#js}}
require(['core/first'], function() {
    {{#autofocusform}}
        var userNameField = document.getElementById('username');
        if (userNameField.value.length == 0) {
            userNameField.focus();
        } else {
            document.getElementById('password').focus();
        }
    {{/autofocusform}}
});
{{/js}}
</body>
</html>