{{!
    @template core/loginform
    FIXED LOGIN FORM WITH PROPER MOODLE TOKENS
    Template: core/loginform.mustache (child theme)
}}

<div class="split-login-container">
    <!-- LEFT SIDE - Branding -->
    <div class="login-left-side">
        <div class="brand-overlay">
            <h1>Welcome to</h1>
            <h2>Southern Academy<br><span>of Higher Education</span></h2>
            <p>Your learning journey starts here</p>
        </div>
    </div>

    <!-- RIGHT SIDE - Login Form -->
    <div class="login-right-side">
        <div class="login-form-area">
            <div class="login-header">
                <!-- Fixed logo approach using correct Moodle method -->
                {{#logourl}}
                    <img src="{{logourl}}" alt="{{sitename}}" class="my-logo">
                {{/logourl}}
                {{^logourl}}
                    {{#output.get_compact_logo_url}}
                        <img src="{{output.get_compact_logo_url}}" alt="{{sitename}}" class="my-logo">
                    {{/output.get_compact_logo_url}}
                    {{^output.get_compact_logo_url}}
                        <h3 class="site-name">{{sitename}}</h3>
                    {{/output.get_compact_logo_url}}
                {{/logourl}}
                
                <h2>Sign in to SAHE</h2>
                <p>Enter your details to continue</p>
            </div>

            {{#error}}
                <div class="alert alert-danger" role="alert">{{{error}}}</div>
            {{/error}}

            <!-- FIXED FORM WITH ALL REQUIRED MOODLE FIELDS -->
            <form class="login-form" action="{{loginurl}}" method="post" id="login">
                
                <!-- CRITICAL: Login token for CSRF protection -->
                <input type="hidden" name="logintoken" value="{{logintoken}}">
                
                <!-- Basic anchor field -->
                <input id="anchor" type="hidden" name="anchor" value="">
                
                <!-- Username Field -->
                <div class="form-field">
                    <label for="username" class="sr-only">{{#str}}username{{/str}}</label>
                    <input type="text"
                           name="username"
                           id="username"
                           class="form-input"
                           value="{{username}}"
                           placeholder="{{#str}}username{{/str}}"
                           autocomplete="username"
                           required>
                </div>

                <!-- Password Field -->
                <div class="form-field">
                    <label for="password" class="sr-only">{{#str}}password{{/str}}</label>
                    <input type="password"
                           name="password"
                           id="password"
                           class="form-input"
                           placeholder="{{#str}}password{{/str}}"
                           autocomplete="current-password"
                           required>
                </div>

                <!-- Remember Me Checkbox -->
                <div class="form-field checkbox-field">
                    <input type="checkbox" name="rememberusername" id="rememberusername" value="1" {{#username}}checked="checked"{{/username}}>
                    <label for="rememberusername">{{#str}}rememberusername, admin{{/str}}</label>
                </div>

                <!-- Submit Button -->
                <button class="login-btn" type="submit" id="loginbtn">{{#str}}login{{/str}}</button>
            </form>

            <!-- Guest Login (if enabled) -->
            {{#canloginasguest}}
            <div class="guest-login">
                <p>{{#str}}someallowguest{{/str}}</p>
                <form action="{{loginurl}}" method="post" id="guestlogin">
                    <input type="hidden" name="logintoken" value="{{logintoken}}">
                    <input type="hidden" name="username" value="guest">
                    <input type="hidden" name="password" value="guest">
                    <button type="submit" class="guest-btn" id="loginguestbtn">{{#str}}loginguest{{/str}}</button>
                </form>
            </div>
            {{/canloginasguest}}

            <!-- Identity Providers (OAuth, etc.) -->
            {{#hasidentityproviders}}
            <div class="social-login">
                <p>{{#str}}potentialidps, auth{{/str}}</p>
                {{#identityproviders}}
                    <a class="social-btn" href="{{url}}" title="{{name}}">
                        {{#iconurl}}<img src="{{iconurl}}" alt="{{name}}" width="20" height="20">{{/iconurl}}
                        {{name}}
                    </a>
                {{/identityproviders}}
            </div>
            {{/hasidentityproviders}}

            <!-- Links -->
            <div class="login-links">
                {{#forgotpasswordurl}}
                    <a href="{{forgotpasswordurl}}" class="link-item">Forgot your password?</a>
                {{/forgotpasswordurl}}
                {{#cansignup}}
                    {{#forgotpasswordurl}}<div class="link-divider">or</div>{{/forgotpasswordurl}}
                    <a href="{{signupurl}}" class="link-item signup-link">Create new account</a>
                {{/cansignup}}
            </div>

            <script>
            // Simple form handling
            document.addEventListener('DOMContentLoaded', function() {
                // Set anchor for form submission
                var anchorField = document.getElementById('anchor');
                if (anchorField) {
                    anchorField.value = location.hash;
                }
                
                // Log form submission for debugging (can be removed in production)
                var loginForm = document.getElementById('login');
                if (loginForm) {
                    loginForm.addEventListener('submit', function(e) {
                        console.log('LOGIN FORM SUBMITTING');
                        console.log('Action:', this.action);
                        console.log('Method:', this.method);
                        console.log('Login token present:', !!document.querySelector('input[name="logintoken"]'));
                        
                        // Let form submit normally - don't prevent default
                        return true;
                    });
                }
            });
            </script>
        </div>
    </div>
</div>